{
  "status": "design handoff mapping, not a deployable Salla theme configuration",
  "date": "2026-10-10",
  "language": "ar",
  "direction": "rtl",
  "audience": "gaming enthusiasts; desk mats and setup accessories",
  "reference": "ar/index.html",
  "theme_base_proposed": "SallaApp/theme-raed",
  "engine": "Twilight",
  "palette": [
    "#101013",
    "#272727",
    "#F2F2F2",
    "#FAE100",
    "#900DFF",
    "#FF0181",
    "#A00082",
    "#32DBF0"
  ],
  "font": "Rubik; locally licensed Arabic and Latin WOFF2",
  "components": [
    {
      "section": "hero",
      "kind": "editable image/text slider",
      "fields": [
        "title",
        "subtitle",
        "desktop_image",
        "mobile_image",
        "slides",
        "primary_link",
        "desktop_secondary_link"
      ],
      "motion_default": "off",
      "mobile_ctas": 1
    },
    {
      "section": "products",
      "kind": "native selected products",
      "replace_with_store_data": [
        "images",
        "titles",
        "links",
        "prices",
        "stock"
      ]
    },
    {
      "section": "choice-guide",
      "kind": "editable collection links",
      "fields": [
        "heading",
        "description",
        "collection_links"
      ]
    },
    {
      "section": "materials",
      "kind": "editable text and optional silent video",
      "fields": [
        "heading",
        "description",
        "poster",
        "video",
        "details",
        "product_link"
      ]
    },
    {
      "section": "addons",
      "kind": "native accessories collection",
      "replace_with_store_data": [
        "images",
        "titles",
        "links",
        "prices",
        "stock"
      ]
    },
    {
      "section": "questions",
      "kind": "editable FAQ",
      "fields": [
        "heading",
        "questions",
        "answers",
        "collection_or_product_links"
      ]
    },
    {
      "section": "setup-cta",
      "kind": "editable call to action",
      "fields": [
        "heading",
        "description",
        "link"
      ]
    }
  ],
  "replace_preview_interactions": [
    "local search -> Salla search",
    "header -> native account/cart components",
    "product discovery links -> actual product URLs"
  ],
  "verification_remaining": [
    "Twilight component schema",
    "SCSS scope in Theme Raed",
    "Salla CLI preview",
    "actual store data",
    "native cart and checkout",
    "iOS and Android device review"
  ],
  "arabic_brand": "صمصام",
  "arabic_logo": "assets/icons/semsaam-logo-ar.svg",
  "catalogue": {
    "reference": "ar/product-list.html",
    "status": "four existing homepage design directions; not approved launch assortment",
    "replace_with_store_data": [
      "collections",
      "products",
      "product_urls",
      "images",
      "prices",
      "availability",
      "native_filters",
      "native_search"
    ]
  },
  "media_formats": "WebP working copies; recovered originals immutable"
}